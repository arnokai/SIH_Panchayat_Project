# Normalize line endings to LF on commit, checkout as-is on Linux
* text=auto eol=lf

# Python source files
*.py text eol=lf

# Web source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Config / data files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Binary files — do not touch line endings
*.nc binary
*.nc4 binary
*.h5 binary
*.hdf5 binary
*.tif binary
*.tiff binary
*.pkl binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
